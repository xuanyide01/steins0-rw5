<template>
 <div class="page" onswipe="swipe">
  <div if="{{mode === 'opening'}}" class="opening-page" onclick="skipOpening"><div class="opening-viewport"><image class="opening-sheet" src="{{openingSrc}}" style="left:{{openingLeft}}px;top:0px;" oncomplete="openingLoaded" onerror="openingError"></image></div></div>
  <div if="{{mode === 'title'}}" class="title-page">
   <image class="title-background" src="/common/title_bg.jpg"></image>
   <div if="{{titleAnimationVisible}}" class="zero-viewport"><image class="zero-sheet" src="{{zeroSrc}}" style="left:{{zeroLeft}}px;"></image></div>
   <image class="brand-logo" src="/common/title-wordmark.png"></image>
   <div class="title-buttons">
    <image class="title-button" src="/common/ui/start.png" onclick="startNew"></image>
    <image class="title-button" src="/common/ui/load.png" onclick="loadGame"></image>
    <image class="title-button" src="/common/ui/extra.png" onclick="openExtra"></image>
    <image class="title-button" src="/common/ui/config.png" onclick="openConfig"></image>
   </div>
   <div class="title-rule"></div><text class="motto">El Psy Kongroo</text>
  </div>
  <div if="{{mode === 'play'}}" class="reading">
   <div class="scene" onclick="advance"><image for="{{sceneImages}}" tid="key" class="layer" src="{{$item.src}}" oncomplete="sceneLayerLoaded($item.key)" onerror="sceneLayerFailed($item.key)" style="left:{{$item.left}}px;top:{{$item.top}}px;width:{{$item.width}}px;height:{{$item.height}}px;opacity:{{$item.opacity}};"></image><div if="{{amadeusVisible}}" class="amadeus-frame"><text class="amadeus-label">Amadeus</text><image class="amadeus-portrait" src="{{amadeusSrc}}"></image></div></div>
   <div class="speaker-row"><text class="speaker" style="font-family:{{speakerFont}};">{{speaker}}</text><text class="date">{{dateLabel}}</text></div>
   <scroll id="dialogue-scroll" class="dialogue-scroll" scroll-y="true" onclick="dialogueTap" ontouchstart="touchStart" ontouchmove="touchMove" ontouchend="touchEnd" onscroll="scrolled"><div class="dialogue-content" style="height:{{dialogueHeight}}px;"><text for="{{lines}}" tid="id" class="line" style="font-family:{{bodyFont}};font-size:{{fontSize}}px;">{{$item.text}}</text></div></scroll>
   <div class="toolbar"><text class="tool" onclick="goBack">上一句</text><text class="tool" onclick="showMenu">{{autoEnabled ? 'AUTO' : '菜单'}}</text><text class="phone-tool" style="color:{{noticeColor}};" onclick="showPhone">{{phoneLabel}}</text><text class="tool" onclick="advance">下一句 ›</text></div>
  </div>
  <div if="{{mode === 'card'}}" class="card-page" onclick="closeCard"><image class="chapter-card" src="{{cardSrc}}"></image></div>
  <div if="{{mode === 'menu' || mode === 'extra' || mode === 'config' || mode === 'choice' || mode === 'end' || mode === 'overwrite'}}" class="panel">
   <text class="section-code">{{panelCode}}</text><text class="heading" style="font-family:{{headingFont}};">{{heading}}</text>
   <text if="{{subtitle !== ''}}" class="subtitle" style="font-family:{{subtitleFont}};">{{subtitle}}</text>
   <scroll id="actions-scroll" class="actions" style="top:{{actionsTop}}px;height:{{actionsViewport}}px;" scroll-y="true"><div class="actions-content" style="height:{{actionsHeight}}px;"><text for="{{actions}}" tid="key" class="action" style="height:{{$item.height}}px;color:{{$item.color}};font-family:{{$item.font}};" onclick="action($idx)">{{$item.text}}</text></div></scroll>
  </div>
  <div if="{{mode === 'list'}}" class="panel">
   <text class="section-code">{{listCode}}</text><text class="heading" style="font-family:{{headingFont}};">{{heading}}</text>
   <text if="{{subtitle !== ''}}" class="list-subtitle" style="font-family:{{subtitleFont}};">{{subtitle}}</text><text class="page-label">{{pageLabel}}</text>
   <div class="rows"><div for="{{rows}}" tid="key" class="row" onclick="rowPick($idx)"><text class="row-title" style="font-family:{{$item.font}};">{{$item.text}}</text><text class="row-meta" style="font-family:{{$item.metaFont}};">{{$item.meta}}</text><text if="{{$item.preview !== ''}}" class="row-preview" style="font-family:{{$item.previewFont}};">{{$item.preview}}</text></div></div>
   <div class="pager"><text class="pager-action" onclick="previousPage">‹ 上一页</text><text class="pager-action" onclick="listBack">返回</text><text class="pager-action" onclick="nextPage">下一页 ›</text></div>
  </div>
  <div if="{{mode === 'gallery'}}" class="panel">
   <text class="section-code">CG LIBRARY</text><text class="heading">CG 鉴赏</text><text class="gallery-page-label">{{galleryPageLabel}}</text>
   <div class="gallery-row gallery-first"><div for="{{galleryTop}}" tid="key" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text class="gallery-caption">{{$item.label}}</text><text class="gallery-count">{{$item.count}}</text></div></div>
   <div class="gallery-row gallery-second"><div for="{{galleryBottom}}" tid="key" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text class="gallery-caption">{{$item.label}}</text><text class="gallery-count">{{$item.count}}</text></div></div>
   <div class="pager"><text class="pager-action" onclick="previousGalleryPage">‹ 上一页</text><text class="pager-action" onclick="openExtra">返回</text><text class="pager-action" onclick="nextGalleryPage">下一页 ›</text></div>
  </div>
  <div if="{{mode === 'cg'}}" class="cg-page">
   <image class="cg-image" src="{{cgSrc}}" onclick="cycleCg"></image><text class="cg-label">{{cgLabel}}</text>
   <div class="cg-controls"><text class="pager-action" onclick="previousCg">‹ 上一组</text><text class="pager-action" onclick="galleryBack">返回列表</text><text class="pager-action" onclick="nextCg">下一组 ›</text></div>
  </div>
  <div if="{{mode === 'phone'}}" class="panel phone-panel">
   <text class="section-code">PHONE</text><text class="heading">{{phoneHeading}}</text><text class="phone-subtitle" style="font-family:{{phoneSubFont}};">{{phoneSub}}</text><text if="{{phoneReplyLabel !== ''}}" class="phone-reply" onclick="replyMessage">{{phoneReplyLabel}}</text><text class="phone-page-label">{{phonePageLabel}}</text>
   <scroll id="phone-scroll" class="phone-scroll" scroll-y="true"><div class="phone-content" style="height:{{phoneHeight}}px;">
    <div for="{{phoneRows}}" tid="key" class="phone-row" style="height:{{$item.height}}px;" onclick="phonePick($idx)"><image if="{{$item.image}}" class="reply-stamp" src="{{$item.image}}"></image><text class="phone-row-title" style="height:{{$item.titleHeight}}px;font-family:{{$item.font}};">{{$item.text}}</text><text class="phone-row-meta" style="font-family:{{$item.metaFont}};">{{$item.meta}}</text></div>
    <div for="{{phoneLines}}" tid="id" class="phone-part" style="height:{{$item.height}}px;"><image if="{{$item.image !== ''}}" class="phone-stamp" src="{{$item.image}}"></image><text if="{{$item.image === ''}}" class="phone-line" style="height:{{$item.height}}px;line-height:{{$item.height}}px;font-size:{{$item.size}}px;font-family:{{$item.font}};color:{{$item.color}};">{{$item.text}}</text></div>
   </div></scroll>
   <div class="pager"><text class="pager-action" onclick="phoneLeft">{{phoneLeftLabel}}</text><text class="pager-action" onclick="phoneBack">{{phoneBackLabel}}</text><text class="pager-action" onclick="phoneRight">{{phoneRightLabel}}</text></div>
  </div>
  <div if="{{mode === 'error'}}" class="panel"><text class="section-code">SYSTEM</text><text class="heading">暂时无法继续</text><text class="error">{{errorText}}</text><text class="error-return" onclick="toTitle">返回标题</text></div>
  <text if="{{loading}}" class="loading">加载中…</text>
 </div>
</template>

<script>
import file from '@system.file';
import storage from '@system.storage';
import audio from '@system.audio';
import prompt from '@system.prompt';
import {configure,getGraph,newState,newChapterState,checkpoint,restore,locate,readFrame,next,choose,phoneChoice,answerCall,nextChapter,previous,markRead,markMessagesRead,sendReply,storyDate,normalizeEndings} from '../../common/engine.js';
import {textFont,cleanText,dialogueText,wrapText} from '../../common/text-font.js';
import {autoDelay,makeAutoClock} from '../../common/autoplay.js';
import {makeTitleMusic} from '../../common/title-music.js';
import {wantsOpening,makeOpeningClock} from '../../common/opening.js';
import {makeTitleAnimation} from '../../common/title-animation.js';
import {slotKey,decodeSave,decodeSlotMeta,createSave,slotRow,slotMeta,SLOT_INDEX_KEY,decodeSlotIndex} from '../../common/saves.js';
import {callHeading,callContact} from '../../common/phone-presentation.js';
import {worldlineFor} from '../../common/worldline.js';
import {imagePath,imagePaths} from '../../common/assets.js';
import {presentedLayer,amadeusImage} from '../../common/scene-presentation.js';
import {mailboxThreads,conversationMessages,threadForMessage,mailDateLabel,mailboxSummary,canReply} from '../../common/conversations.js';
import {planTextRows,revealTextRows,nextGlyphEnd} from '../../common/text-reveal.js';
import {FONT_SIZES,TEXT_MODES,settingsFrom,fontName,textModeName,pageLabel,sentenceStops} from '../../common/presentation.js';
export default {
 private:{openingSrc:'',openingLeft:0,openingTop:0,mode:'title',loading:false,errorText:'',speaker:'',speakerFont:'sans-serif',bodyFont:'sans-serif',dateLabel:'',amadeusVisible:false,amadeusSrc:'',lines:[],dialogueHeight:140,fontSize:24,sceneImages:[],autoEnabled:false,phoneLabel:'手机',noticeColor:'#c7bcaf',mediaBusy:false,animationEnabled:true,titleAnimationVisible:false,zeroSrc:'/common/title-machine/atlas00.png',zeroLeft:0,heading:'',headingFont:'sans-serif',subtitle:'',subtitleFont:'sans-serif',panelCode:'SYSTEM',actions:[],actionsHeight:370,actionsTop:112,actionsViewport:382,listCode:'CHAPTER',pageLabel:'',rows:[],cardSrc:'',galleryPageLabel:'',galleryTop:[],galleryBottom:[],cgSrc:'',cgLabel:'',phoneHeading:'手机',phoneSub:'',phoneSubFont:'sans-serif',phonePageLabel:'',phoneHeight:322,phoneReplyLabel:'',phoneRows:[],phoneLines:[],phoneLeftLabel:'‹ 上一页',phoneBackLabel:'返回剧情',phoneRightLabel:'下一页 ›'},

 onInit(){
  this._destroyed=false;this._visible=true;this._seq=0;this._ui=0;this._cache=null;this._phoneSeq=0;this._slotSeq=0;this._gallerySeq=0;
  this._titleContext=true;this._settingsReady=false;this._startupReady=false;this._animationReady=false;this._graphWaiting=[];this._slotCatalog=null;this._slotIndexWaiting=[];
  this._progress={endings:{},rate:'1.129848'};this._settings=settingsFrom();this._galleryPage=0;this._routePage=0;
  this._auto=makeAutoClock(setTimeout,clearTimeout);
  this._openingReturn='story';this._openingReady=false;this._openingRunning=false;this._openingPlayer=makeOpeningClock(setTimeout,clearTimeout,()=>Date.now(),(src,left)=>{if(this.openingSrc!==src)this.openingSrc=src;if(this.openingLeft!==left)this.openingLeft=left;},()=>this.finishOpening('ended'));
  this._music=makeTitleMusic(audio,(ok,busy)=>{this.mediaBusy=busy;this.syncMedia();});
  this._animation=makeTitleAnimation(setTimeout,clearTimeout,()=>this.titleAnimationVisible,(src,left)=>{this.zeroSrc=src;this.zeroLeft=left;});
  this.loadStorage('steins0_rw5_progress',raw=>{if(this._destroyed)return;if(raw){try{const saved=JSON.parse(raw),endings=normalizeEndings(saved.endings);this._progress={endings,rate:saved.rate||'1.129848'};if(saved.endings&&saved.endings[5]&&!saved.endings[3]){this.writeStorage('steins0_rw5_progress',this._progress);console.log('STEINS0_RW5 repaired legacy true-ending award');}}catch(e){}}});
  this.loadStorage('steins0_rw5_config',raw=>{if(this._destroyed)return;let saved;try{saved=raw?JSON.parse(raw):null;}catch(e){}this._settings=settingsFrom(saved);this.fontSize=this._settings.font;this.animationEnabled=this._settings.animation;this._settingsReady=true;this.armStartup();});
 },
 armStartup(){
  if(this._destroyed||!this._visible||!this._settingsReady)return;
  if(!this._startupReady){if(!this._startupTimer)this._startupTimer=setTimeout(()=>{this._startupTimer=null;if(this._destroyed||!this._visible)return;this._startupReady=true;console.log('STEINS0_RW5 startup music ready');this.syncMedia();this.armStartup();},800);return;}
  if(!this._animationReady&&!this._animationWarmup)this._animationWarmup=setTimeout(()=>{this._animationWarmup=null;if(this._destroyed||!this._visible)return;this._animationReady=true;console.log('STEINS0_RW5 startup animation ready');this.syncMedia();},900);
  this.syncMedia();
 },
 cancelStartup(){if(this._startupTimer)clearTimeout(this._startupTimer);this._startupTimer=null;if(this._animationWarmup)clearTimeout(this._animationWarmup);this._animationWarmup=null;},
 ensureGraph(done){
  if(this._graph){done();return;}this._graphWaiting.push(done);if(this._graphLoading)return;
  this._graphLoading=true;this.loading=true;this.syncMedia();console.log('STEINS0_RW5 graph lazy load');
  this.readJSON('/common/graph.txt',g=>{configure(g);this._graph=g;this._graphLoading=false;this.loading=false;const waiting=this._graphWaiting;this._graphWaiting=[];for(const next of waiting)next();this.syncMedia();},()=>!this._destroyed);
 },
 onShow(){this._visible=true;this.armStartup();if(this.mode==='opening'){this.resumeOpening();return;}if(this.mode==='play'&&this._state)this.present();else if(this.mode==='card')this.closeCard();},
 onHide(){this._visible=false;this.pauseOpening();this.cancelStartup();this.cancelReading();if(this._cardTimer)clearTimeout(this._cardTimer);this._cardTimer=null;if(this._noticeTimer)clearInterval(this._noticeTimer);this._noticeTimer=null;this.titleAnimationVisible=false;this._music.stop();this._animation.stop();},
 onDestroy(){this._destroyed=true;this.pauseOpening();this._openingPlayer.stop();this._seq++;this._slotSeq++;this._phoneSeq++;this._gallerySeq++;this.cancelStartup();this.cancelReading();if(this._noticeTimer)clearInterval(this._noticeTimer);if(this._cardTimer)clearTimeout(this._cardTimer);this.titleAnimationVisible=false;this._animation.stop();this._music.destroy();this._graphWaiting=[];this._slotIndexWaiting=[];this._cache=null;this._phoneCache=null;},
 readJSON(uri,done,valid){file.readText({uri,complete:()=>{},success:r=>{if(valid&&!valid())return;try{done(JSON.parse(r.text));}catch(e){this.fail(e);}},fail:(d,c)=>{if(!valid||valid())this.fail('读取资源失败 '+uri+' / '+c);}});},

 loadStorage(key,done){storage.get({key,complete:()=>{},success:r=>done(r||''),fail:()=>done('')});},

 writeStorage(key,value,done){storage.set({key,value:JSON.stringify(value),complete:()=>{},success:()=>{if(done)done();},fail:(d,c)=>this.fail('保存失败 '+c)});},

 fail(e){console.error('STEINS0_RW5 error',String(e&&e.message||e));this.loading=false;this._saving=false;this._slotRestoreLoading=false;this._graphLoading=false;this._graphWaiting=[];this.cancelReading();this.mode='error';this.errorText=String(e&&e.message||e).slice(0,180);this.syncMedia();},
 syncMedia(){
  if(!this._music||!this._animation||this._destroyed)return;if(this.mode==='opening'){this.titleAnimationVisible=false;this._animation.stop();return;}
  const quiet=this._graphLoading||this._slotRestoreLoading,allowed=this._settingsReady&&this._startupReady&&this._titleContext&&!quiet&&['title','extra','config','list','gallery','cg','overwrite'].indexOf(this.mode)>=0;
  this._music.update(!!(this._visible&&this._settings.sound&&allowed));
  this.titleAnimationVisible=!!(this._visible&&this.mode==='title'&&this._settingsReady&&this._startupReady&&this._animationReady&&this.animationEnabled&&!quiet&&!this.mediaBusy);
  this._animation.update();
 },

 cancelReading(){if(this._typeTimer)clearTimeout(this._typeTimer);this._typeTimer=null;if(this._auto)this._auto.cancel();this._typeGeneration=(this._typeGeneration||0)+1;},
 setMode(mode){this.cancelReading();if(mode!=='play'&&this._noticeTimer){clearInterval(this._noticeTimer);this._noticeTimer=null;}if(mode!=='phone')this._phoneSeq++;this.mode=mode;console.log('STEINS0_RW5 mode '+mode);this.syncMedia();},

 panel(mode,title,subtitle,actions){
  this.setMode(mode);this.panelCode={menu:'SYSTEM',config:'CONFIG',extra:'EXTRA',choice:'PHONE TRIGGER',end:'ENDING',overwrite:'SAVE DATA'}[mode]||'SYSTEM';
  this.heading=cleanText(title);this.headingFont=textFont(this.heading);this.subtitle=cleanText(subtitle||'');this.subtitleFont=textFont(this.subtitle);
  this.actionsTop=mode==='menu'?94:this.subtitle?122:112;this.actionsViewport=498-this.actionsTop;
  const height=mode==='menu'?44:53,uid=++this._ui;this._actions=actions;this.actionsHeight=Math.max(this.actionsViewport,actions.length*height);
  this.actions=actions.map((a,i)=>({key:uid+':'+i,text:cleanText(a.text),font:textFont(a.text),height,color:a.fn==='toTitle'?'#b1a39b':a.color||'#e3ded7'}));
  try{this.$element('actions-scroll').scrollTo({top:0,left:0,behavior:'instant'});}catch(e){}
 },

 action(index){if(this._saving)return;const item=this._actions[index];if(item&&typeof this[item.fn]==='function')this[item.fn](item.value);},
 startNew(){if(this._graphLoading)return;this._titleContext=false;this.setMode('boot');if(!this._graph){this.ensureGraph(()=>this.startNew());return;}this._titleContext=false;this._seq++;this._cache=null;this._state=newState();Object.assign(this._state.endings,this._progress.endings);this.autoEnabled=false;this.present();},

 resume(){if(this._state&&!this._state.ended)this.present();else this.toTitle();},
 present(){
  if(!this._state)return;this.cancelReading();this._seq++;const token=this._seq;this.loading=true;
  try{const place=locate(this._state);if(place.type==='choice'){this.loading=false;this.showChoice(place);return;}if(place.type==='end'){this.loading=false;this.finishGame();return;}
   const render=chunk=>{if(token!==this._seq)return;try{const f=readFrame(chunk,this._state,place.base);this.loading=false;if(f.type!=='text'){this.present();return;}console.log('STEINS0_RW5 frame '+this._state.chapter+' '+this._state.cursor+' '+this._state.sourceSite);if(wantsOpening(this._state)){this._openingReturn='story';this.startOpening();return;}this.drawScene();if(this._state.lastCard!==this._state.group){this._state.lastCard=this._state.group;this.cardSrc='/common/chapter-cards/'+this._state.group+'.jpg';this.setMode('card');if(this._visible)this._cardTimer=setTimeout(()=>{this._cardTimer=null;if(this.mode==='card')this.closeCard();},3500);return;}this.startText();}catch(e){this.fail(e);}};
   if(this._cache&&this._cache.file===place.file)render(this._cache.data);else this.readJSON('/common/story/'+place.file,data=>{if(token!==this._seq)return;this._cache={file:place.file,data};render(data);});
  }catch(e){this.fail(e);}
 },
 closeCard(){if(this._cardTimer)clearTimeout(this._cardTimer);this._cardTimer=null;if(this.mode==='card')this.startText();},
 drawScene(){const specs=(this._state.sceneLayers||[]).map(presentedLayer),signature=JSON.stringify(specs);if(signature!==this._sceneSignature){this._sceneSignature=signature;this._sceneEpoch=(this._sceneEpoch||0)+1;this.sceneImages=specs.reduce((out,v,i)=>{const files=imagePaths(v[0]);files.forEach((src,j)=>out.push({key:this._sceneEpoch+':'+i+':'+j,group:i,ready:false,src,left:v[1],top:v[2],width:v[3],height:v[4],targetOpacity:v[5]/1000,opacity:files.length>1?0:v[5]/1000}));return out;},[]);}this.speaker=cleanText(this._state.speaker);this.speakerFont=textFont(this.speaker);const avatar=amadeusImage(this.speaker,this._state.sceneLayers);this.amadeusVisible=!!avatar;this.amadeusSrc=avatar?imagePath(avatar):'';this.dateLabel=storyDate(this._state);this.refreshNotice();},
 sceneLayerLoaded(key){const item=this.sceneImages.find(x=>x.key===key);if(!item||item.ready)return;item.ready=true;const group=this.sceneImages.filter(x=>x.group===item.group);if(group.every(x=>x.ready))for(const row of group)row.opacity=row.targetOpacity;},
 sceneLayerFailed(key){if(this.mode==='play'&&this.sceneImages.some(x=>x.key===key))this.fail('场景图片读取失败，请重启后读取存档重试');},
 startText(){
  this.setMode('play');this.drawScene();this._body=dialogueText(this._state.text);this.bodyFont=textFont(this._body);this._wrapped=wrapText(this._body,384,this.fontSize);
  this.dialogueHeight=Math.max(140,this._wrapped.split('\n').length*34+20);this._typed=0;this._scrollPaused=false;this._ignoreScrollUntil=Date.now()+400;
  try{this.$element('dialogue-scroll').scrollTo({top:0,left:0,behavior:'instant'});}catch(e){}
  const plan=planTextRows(this._wrapped,++this._ui);this._textRanges=plan.ranges;this.lines=plan.rows;
  const mode=this._settings.textMode;this._sentenceStops=sentenceStops(this._wrapped);this._sentenceIndex=0;
  if(mode==='instant'){this._typed=this._wrapped.length;this.paintText(this._wrapped);this.armAuto();return;}
  if(mode==='sentence'){this._typed=this._sentenceStops[0];this.paintText(this._wrapped.slice(0,this._typed));this.armAuto();return;}
  const token=this._typeGeneration;this.paintText('');if(!this._visible)return;
  const tick=()=>{
   if(token!==this._typeGeneration||this.mode!=='play'||!this._visible)return;
   this._typeTimer=null;this._typed=nextGlyphEnd(this._wrapped,this._typed);this.paintText(this._wrapped.slice(0,this._typed));
   if(this._typed<this._wrapped.length)this._typeTimer=setTimeout(tick,30);else this.armAuto();
  };
  if(this._wrapped.length)this._typeTimer=setTimeout(tick,30);else this.armAuto();
 },

 paintText(text){revealTextRows(this.lines,this._textRanges,text.length);},
 armAuto(){if(!this.autoEnabled||this._scrollPaused||this.mode!=='play'||!this._visible)return;let length=this._body.length;if(this._settings.textMode==='sentence'){const before=this._sentenceIndex?this._sentenceStops[this._sentenceIndex-1]:0;length=this._typed-before;}this._auto.arm(autoDelay(length,this._settings.autoSpeed),()=>this.autoEnabled&&this.mode==='play'&&this._visible&&!this._scrollPaused,()=>this.advance());},

 advance(){
  if(this.mode!=='play'||this.loading)return;
  if(this._typeTimer){clearTimeout(this._typeTimer);this._typeTimer=null;this._typeGeneration++;this._typed=this._wrapped.length;this.paintText(this._wrapped);this._scrollPaused=false;this.armAuto();return;}
  if(this._settings.textMode==='sentence'&&this._sentenceIndex<this._sentenceStops.length-1){this._sentenceIndex++;this._typed=this._sentenceStops[this._sentenceIndex];this.paintText(this._wrapped.slice(0,this._typed));this._scrollPaused=false;this.armAuto();return;}
  this._scrollPaused=false;try{next(this._state);this.present();}catch(e){this.fail(e);}
 },

 dialogueTap(){if(Date.now()<(this._dragUntil||0))return;this._scrollPaused=false;this.advance();},
 touchStart(e){const t=e.touches&&e.touches.length?e.touches[0]:e;this._touchY=typeof t.localY==='number'?t.localY:typeof t.y==='number'?t.y:0;},

 touchMove(e){const t=e.touches&&e.touches.length?e.touches[0]:e,y=typeof t.localY==='number'?t.localY:typeof t.y==='number'?t.y:this._touchY;if(Math.abs(y-this._touchY)>6){this._dragUntil=Date.now()+400;this._scrollPaused=true;this._auto.cancel();}},

 touchEnd(){if(this._scrollPaused)this._dragUntil=Date.now()+400;},
 scrolled(){if(Date.now()<(this._ignoreScrollUntil||0))return;this._dragUntil=Date.now()+400;this._scrollPaused=true;this._auto.cancel();},

 swipe(e){if(this.mode==='play'&&(e.direction==='up'||e.direction==='down')){this._scrollPaused=true;this._auto.cancel();}},
 goBack(){this.autoEnabled=false;try{if(previous(this._state))this.present();}catch(e){this.fail(e);}},
 showChoice(choice){this._currentChoice=choice;this.panel('choice',callHeading(choice),choice.category,choice.items.map((x,i)=>({text:x.text,fn:'pickChoice',value:i})).concat([{text:'手机',fn:'showPhone'},{text:'菜单',fn:'showMenu'}]));},
 pickChoice(index){try{choose(this._state,this._currentChoice.items[index],index);this.present();}catch(e){this.fail(e);}},
 showMenu(){if(!this._state)return;this.panel('menu','阅读菜单','',[
  {text:'保存进度',fn:'saveGame'},{text:'读取进度',fn:'loadGame'},{text:'下一章 ›',fn:'skipChapter'},
  {text:'自动播放：'+(this.autoEnabled?'开启':'关闭'),fn:'toggleAuto'},{text:'自动速度：'+['慢速','标准','快速'][this._settings.autoSpeed],fn:'toggleAutoSpeed'},
  {text:'文字显示：'+textModeName(this._settings.textMode),fn:'toggleTextMode'},{text:'字号：'+fontName(this.fontSize),fn:'toggleFont'},
  {text:'返回游戏',fn:'resume'},{text:'返回标题',fn:'toTitle'}]);},

 skipChapter(){try{nextChapter(this._state);this.present();}catch(e){this.fail(e);}},
 toggleAuto(){this.autoEnabled=!this.autoEnabled;this.showMenu();},
 toggleAutoSpeed(){this._settings.autoSpeed=(this._settings.autoSpeed+1)%3;this.saveSettings();this.mode==='config'?this.openConfig():this.showMenu();},
 toggleFont(){this.fontSize=FONT_SIZES[(FONT_SIZES.indexOf(this.fontSize)+1)%FONT_SIZES.length];this._settings.font=this.fontSize;this.saveSettings();this.mode==='config'?this.openConfig():this.showMenu();},
 toggleTextMode(){this._settings.textMode=TEXT_MODES[(TEXT_MODES.indexOf(this._settings.textMode)+1)%TEXT_MODES.length];this.saveSettings();this.mode==='config'?this.openConfig():this.showMenu();},

 toggleSound(){this._settings.sound=!this._settings.sound;if(this._settings.sound)this._music.retry();this.saveSettings();this.openConfig();},

 toggleAnimation(){this.animationEnabled=!this.animationEnabled;this._settings.animation=this.animationEnabled;this.saveSettings();this.openConfig();},
 saveSettings(){this.writeStorage('steins0_rw5_config',this._settings);},
 openConfig(){this.panel('config','设置','',[
  {text:'文字显示：'+textModeName(this._settings.textMode),fn:'toggleTextMode'},{text:'字号：'+fontName(this.fontSize),fn:'toggleFont'},
  {text:'自动速度：'+['慢速','标准','快速'][this._settings.autoSpeed],fn:'toggleAutoSpeed'},{text:'游戏音量：'+(this._settings.sound?'开启':'关闭'),fn:'toggleSound'},
  {text:'标题动画：'+(this.animationEnabled?'开启':'关闭'),fn:'toggleAnimation'},{text:'返回标题',fn:'toTitle'}]);},

 openExtra(){this.panel('extra','扩展','',[{text:'CG 鉴赏',fn:'openGallery'},{text:'选择路线与章节',fn:'openRoutes'},{text:'OP MOVIE / 观看 OP',fn:'watchOpening'},{text:'通关记录',fn:'openEndings'},{text:'返回标题',fn:'toTitle'}]);},

 watchOpening(){if(this.mode!=='extra'||this.loading)return;this._openingReturn='extra';this.startOpening();},
 startOpening(){
  this.cancelReading();this._music.stop();this._animation.stop();this._cache=null;this.sceneImages=[];this._sceneSignature='';this.lines=[];this._wrapped='';this._body='';this.phoneRows=[];this.phoneLines=[];this.amadeusVisible=false;
  this.loading=false;this._openingReady=false;this._openingRunning=false;this.setMode('opening');this._openingPlayer.reset();this.resumeOpening();console.log('STEINS0_RW5 opening start '+this._openingReturn);
 },
 pauseOpening(){if(this._openingPlayer)this._openingPlayer.pause();this._openingRunning=false;if(this._openingLoadTimer)clearTimeout(this._openingLoadTimer);this._openingLoadTimer=null;},
 resumeOpening(){
  if(this.mode!=='opening'||!this._visible||this._destroyed||this._openingRunning)return;
  if(!this._openingReady){if(this._openingLoadTimer)clearTimeout(this._openingLoadTimer);this._openingLoadTimer=setTimeout(()=>this.openingError(),10000);return;}
  if(this._settings.sound)this._music.playOpening(this._openingPlayer.position());this._openingRunning=true;this._openingPlayer.resume();
 },
 openingLoaded(){if(this.mode!=='opening'||this._openingReady)return;this._openingReady=true;if(this._openingLoadTimer)clearTimeout(this._openingLoadTimer);this._openingLoadTimer=null;this.resumeOpening();console.log('STEINS0_RW5 opening playing');},
 openingError(){if(this.mode!=='opening')return;console.log('STEINS0_RW5 opening unavailable; continue safely');prompt.showToast({message:'OP暂时无法播放，已略过'});this.finishOpening('unavailable');},
 skipOpening(){if(this.mode==='opening')this.finishOpening('skipped');},
 finishOpening(reason){
  if(this.mode!=='opening')return;this.pauseOpening();this._openingPlayer.stop();this._music.stop();this.openingSrc='';this.mode='boot';console.log('STEINS0_RW5 opening complete '+reason+' '+this._openingReturn);
  if(this._openingReturn==='extra'){this._openingReturn='story';this.openExtra();}else{this._state.openingDone=true;this.present();}
 },
 finishGame(){this._progress.endings=normalizeEndings(Object.assign({},this._progress.endings,this._state.endings));this._state.endings=normalizeEndings(this._state.endings);this._progress.rate=worldlineFor(this._state);this.writeStorage('steins0_rw5_progress',this._progress);this.panel('end',this._state.endingName,'END',[{text:'返回标题',fn:'toTitle'}]);},
 toTitle(){this._seq++;this._slotSeq++;this._gallerySeq++;this.autoEnabled=false;this._cache=null;this._state=null;this._thread=null;this._phoneItems=[];this._phonePageItems=[];this.amadeusVisible=false;this._phoneCache=null;this.sceneImages=[];this._sceneSignature='';this.lines=[];this.phoneLines=[];this.phoneRows=[];this.rows=[];this._titleContext=true;this.loading=false;this.setMode('title');},

 list(kind,title,subtitle,items,back){this._list={kind,title,subtitle,items,page:0,back};this.renderList();},
 renderList(){
  const l=this._list,uid=++this._ui,pages=Math.max(1,Math.ceil(l.items.length/4));l.page=Math.max(0,Math.min(pages-1,l.page));this.setMode('list');
  this.listCode={slots:this._slotKind==='save'?'SAVE':'LOAD',routes:'CHAPTER SELECT',chapters:'CHAPTER SELECT',endings:'CLEAR LIST'}[l.kind]||'SYSTEM';
  this.heading=cleanText(l.title);this.headingFont=textFont(this.heading);this.subtitle=cleanText(l.subtitle||'');this.subtitleFont=textFont(this.subtitle);this.pageLabel=pageLabel(l.page,pages);
  console.log('STEINS0_RW5 list '+l.kind+' '+l.page);this._pageItems=l.items.slice(l.page*4,l.page*4+4);
  this.rows=this._pageItems.map((x,i)=>({key:l.kind+':'+uid+':'+i,text:cleanText(x.text),font:textFont(x.text),meta:cleanText(x.meta||''),metaFont:textFont(x.meta||''),preview:cleanText(x.preview||'').slice(0,20),previewFont:textFont(x.preview||'')}));
 },

 previousPage(){if(this._list.page<=0)return;this._list.page--;this.renderList();if(this._list.kind==='slots')this.loadSlotPage();},
 nextPage(){if(this._list.page>=Math.ceil(this._list.items.length/4)-1)return;this._list.page++;this.renderList();if(this._list.kind==='slots')this.loadSlotPage();},
 listBack(){this._slotSeq++;this.loading=false;this._slotRestoreLoading=false;const fn=this._list.back||'openExtra';if(typeof this[fn]==='function')this[fn]();},

 rowPick(i){if(this.loading)return;const row=this._pageItems[i];if(row&&typeof this[row.fn]==='function')this[row.fn](row.value);},
 saveGame(){this.openSlots('save');},loadGame(){this.openSlots('load');},
 openSlots(kind){
  if(!this._graph){this.ensureGraph(()=>this.openSlots(kind));return;}
  const back=this._titleContext?'toTitle':'showMenu';this._slotKind=kind;this._slotSeq++;
  this.list('slots',kind==='save'?'选择保存栏位':'选择读取栏位','共 30 个栏位',Array.from({length:30},(_,i)=>({text:'存档 '+('0'+(i+1)).slice(-2),meta:'读取中…',fn:'selectSlot',value:i})),back);this.loadSlotPage();
 },
 ensureSlotIndex(done){
  if(this._slotCatalog){done();return;}this._slotIndexWaiting.push(done);if(this._slotIndexLoading)return;this._slotIndexLoading=true;
  this.loadStorage(SLOT_INDEX_KEY,raw=>{if(this._destroyed)return;try{this._slotCatalog=decodeSlotIndex(raw);}catch(e){this._slotCatalog={};}this._slotIndexLoading=false;const waiting=this._slotIndexWaiting;this._slotIndexWaiting=[];for(const next of waiting)next();});
 },
 persistSlotIndex(){if(!this._slotCatalog)return;storage.set({key:SLOT_INDEX_KEY,value:JSON.stringify({version:1,slots:this._slotCatalog}),success:()=>{},fail:()=>{console.log('STEINS0_RW5 optional slot index write failed');}});},
 loadSlotPage(){
  const l=this._list,page=l.page,seq=this._slotSeq,valid=()=>!this._destroyed&&seq===this._slotSeq&&this._list===l&&this.mode==='list'&&l.page===page;this.loading=true;
  this.ensureSlotIndex(()=>{
   if(!valid())return;const indices=Array.from({length:Math.min(4,30-page*4)},(_,i)=>page*4+i);let cursor=0,changed=false;
   const finish=()=>{if(!valid())return;for(const i of indices){const row=slotRow(i,this._slotCatalog[i]);l.items[i]={text:row.title,meta:row.meta.slice(0,62),preview:row.preview,fn:'selectSlot',value:i};}this.loading=false;this.renderList();if(changed)this.persistSlotIndex();console.log('STEINS0_RW5 slots ready '+page);};
   const next=()=>{if(!valid())return;while(cursor<indices.length&&Object.prototype.hasOwnProperty.call(this._slotCatalog,indices[cursor]))cursor++;if(cursor>=indices.length){finish();return;}
    const i=indices[cursor++];this.loadStorage(slotKey(i),raw=>{if(!valid())return;try{this._slotCatalog[i]=decodeSlotMeta(raw);}catch(e){this._slotCatalog[i]={invalid:true};}changed=true;next();});
   };next();
  });
 },
 selectSlot(i){
  if(this.loading||!this._slotCatalog||!Object.prototype.hasOwnProperty.call(this._slotCatalog,i))return;
  const l=this._list,kind=this._slotKind,seq=++this._slotSeq;this.loading=true;this._slotRestoreLoading=true;this.syncMedia();
  this.loadStorage(slotKey(i),raw=>{
   if(this._destroyed||seq!==this._slotSeq||this._list!==l||this.mode!=='list')return;
   this.loading=false;this._slotRestoreLoading=false;
   if(kind==='load'){
    if(!raw){this._slotCatalog[i]=null;this.persistSlotIndex();this.loadSlotPage();this.syncMedia();return;}
    try{this._titleContext=false;this.setMode('boot');const save=decodeSave(raw);this._state=save.state;Object.assign(this._state.endings,this._progress.endings);this._cache=null;this.autoEnabled=false;this.present();}catch(e){this.fail(e);}return;
   }
   if(!this._state)return;this._writeSlot=i;if(raw)this.panel('overwrite','覆盖存档？','存档 '+('0'+(i+1)).slice(-2),[{text:'确认覆盖',fn:'confirmSave'},{text:'取消',fn:'saveGame'}]);else this.confirmSave();
  });
 },
 confirmSave(){
  if(this._saving||!this._state)return;this._saving=true;this.loading=true;const state=this._state,index=this._writeSlot,savedAt=Date.now(),sceneMode=state.choice?'choice':'play',value=createSave(state,sceneMode,savedAt),meta=slotMeta(value);
  this.writeStorage(slotKey(index),value,()=>{
   this._saving=false;this.loading=false;if(this._destroyed)return;if(!this._slotCatalog)this._slotCatalog={};this._slotCatalog[index]=meta;this.persistSlotIndex();this._progress.rate=worldlineFor(value.state);this.writeStorage('steins0_rw5_progress',this._progress);prompt.showToast({message:'保存成功'});
   console.log('STEINS0_RW5 saved '+index);if(this._state===state&&['list','overwrite'].indexOf(this.mode)>=0)this.resume();
  });
 },
 openRoutes(){if(!this._graph){this.ensureGraph(()=>this.openRoutes());return;}this.list('routes','选择路线与章节','',this._graph.titles.map((text,i)=>({text,meta:'点击选择章节',fn:'openChapters',value:i})),'openExtra');this._list.page=this._routePage||0;this.renderList();},

 openChapters(group){this._routePage=Math.floor(group/4);this._browseGroup=group;const chapters=Object.keys(this._graph.starts).map(k=>this._graph.starts[k]).filter(x=>x.group===group).sort((a,b)=>a.script-b.script);this.list('chapters','选择章节',this._graph.titles[group],chapters.map((x,i)=>({text:storyDate({date:x.date}),meta:'第 '+(i+1)+' 节',fn:'startChapter',value:x})),'openRoutes');},

 startChapter(item){this._titleContext=false;this._cache=null;this._state=newChapterState(item);Object.assign(this._state.endings,this._progress.endings);this.autoEnabled=false;this.present();},

 openEndings(){if(!this._graph){this.ensureGraph(()=>this.openEndings());return;}this.list('endings','通关记录','',this._graph.endings.map((text,i)=>({text,meta:this._progress.endings[i]?'已完成':'未完成'})),'openExtra');},
 openGallery(){if(this._gallery){this.galleryList();return;}const seq=++this._gallerySeq;this.loading=true;this.readJSON('/common/gallery.txt',g=>{this.loading=false;this._gallery=g;this._galleryTotal=g.reduce((n,x)=>n+x.images.length,0);this.galleryList();},()=>seq===this._gallerySeq);},

 galleryList(){
  this.setMode('gallery');const pages=Math.max(1,Math.ceil(this._gallery.length/4));this._galleryPage=Math.max(0,Math.min(pages-1,this._galleryPage));
  const start=this._galleryPage*4,uid=++this._ui,items=this._gallery.slice(start,start+4).map((g,i)=>({key:uid+':'+(start+i),index:start+i,src:imagePath(g.images[0]),label:'CG '+('00'+(start+i+1)).slice(-3),count:g.images.length+' 张'+(g.images.length>1?'差分':'')}));
  this.galleryTop=items.slice(0,2);this.galleryBottom=items.slice(2,4);this.galleryPageLabel=this._gallery.length+' 组 · '+(this._galleryTotal||this._gallery.reduce((n,g)=>n+g.images.length,0))+' 张\n'+pageLabel(this._galleryPage,pages);
  console.log('STEINS0_RW5 gallery '+this._galleryPage+' '+items.length);
 },
 previousGalleryPage(){if(this._galleryPage<=0)return;this._galleryPage--;this.galleryList();},
 nextGalleryPage(){if(this._galleryPage>=Math.ceil(this._gallery.length/4)-1)return;this._galleryPage++;this.galleryList();},

 viewCg(i){if(!this._gallery||i<0||i>=this._gallery.length)return;this._cgIndex=i;this._cgVariant=0;this.drawCg();},
 drawCg(){this.setMode('cg');const g=this._gallery[this._cgIndex];this.cgSrc=imagePath(g.images[this._cgVariant]);this.cgLabel='CG '+('00'+(this._cgIndex+1)).slice(-3)+(g.images.length>1?' · 第 '+(this._cgVariant+1)+' 张，共 '+g.images.length+' 张 · 点击切换':'');console.log('STEINS0_RW5 cg '+this._cgIndex+' '+this._cgVariant);},
 cycleCg(){if(this.mode!=='cg'||this._gallery[this._cgIndex].images.length<2)return;this._cgVariant=(this._cgVariant+1)%this._gallery[this._cgIndex].images.length;this.drawCg();},
 previousCg(){if(this._cgIndex>0)this.viewCg(this._cgIndex-1);},
 nextCg(){if(this._cgIndex<this._gallery.length-1)this.viewCg(this._cgIndex+1);},
 galleryBack(){this._galleryPage=Math.floor(this._cgIndex/4);this.galleryList();},

refreshNotice(){
  if(this._noticeTimer)clearInterval(this._noticeTimer);this._noticeTimer=null;
  const state=this._state;if(!state||this.mode!=='play'||!this._visible)return;
  const incoming=state.inbox.some(x=>state.read.indexOf(x.key)<0),call=phoneChoice(state);
  this.phoneLabel=call?'来电／手机':incoming?'有新 RINE':'手机';this.noticeColor='#c7bcaf';
  if(call||incoming){let on=true;this._noticeTimer=setInterval(()=>{on=!on;this.noticeColor=on?'#b5d1d4':'#6f6261';},700);}
 },
 showPhone(){if(!this._state)return;this._thread=null;this._phoneSection='home';this._phonePage=0;this.renderPhone();},
 phoneAccept(){try{answerCall(this._state,true);this.present();}catch(e){this.fail(e);}},
 phoneDecline(){try{answerCall(this._state,false);this.present();}catch(e){this.fail(e);}},
 openInbox(){markRead(this._state);this._thread=null;this._phoneSection='inbox';this._phonePage=0;this.renderPhone();},
 openSent(){this._thread=null;this._phoneSection='sent';this._phonePage=0;this.renderPhone();},
 openContacts(){this._thread=null;this._phoneSection='contacts';this._phonePage=0;this.renderPhone();},
 contactName(id){return this._graph.phone.names[id]||this._graph.phone.contactNames[id]||'Unknown';},
 phoneContactName(id){return this._graph.phone.contactNames[id]||this._graph.phone.names[id]||this._graph.phone.contactNumbers[id]||'Unknown';},
 threadPeer(thread){if(!thread.sent)return thread.sender;const m=conversationMessages(this._state,thread).find(x=>x.sender!==0);return m?m.sender:thread.latest.contact;},
 renderPhone(){
  if(!this._state)return;this._phoneSeq++;this.setMode('phone');this.loading=false;this.phoneLines=[];this.phoneReplyLabel='';this._phonePage=this._phonePage||0;
  const section=this._phoneSection||'home',call=phoneChoice(this._state),contacts=this._graph.phone.contacts.filter((id,i)=>this._state.contacts&(1<<i));let items=[];
  this.phoneSub='RINE';this.phoneSubFont='sans-serif';
  if(section==='home'){
   this.phoneHeading='手机';items=[{text:'收信箱',meta:mailboxSummary(this._state),fn:'openInbox'},{text:'已发送',meta:mailboxThreads(this._state,true).length+' 组 · '+this._state.sent.length+' 条消息',fn:'openSent'},{text:'联系人',meta:contacts.length+' 位联系人',fn:'openContacts'}];
   if(call)items.push({text:'当前电话与手机操作',meta:call.critical?'本段有关键操作':'本段有可处理来电',fn:'openPhoneCalls'});
  }else if(section==='inbox'||section==='sent'){
   const sent=section==='sent',threads=mailboxThreads(this._state,sent);this.phoneHeading=sent?'已发送':'收信箱';this.phoneSub=threads.length+' 组对话 · '+(sent?this._state.sent:this._state.inbox).length+' 条消息';
   items=threads.map(t=>({text:this.contactName(this.threadPeer(t)),meta:mailDateLabel(t.date)+' · '+t.messages.length+' 条消息'+(canReply(this._state,t)?' · 可回复':t.latest.stamp?' · 动画表情':' · 点击查看'),fn:'openThread',value:t}));
   if(!items.length)items=[{text:sent?'暂无已发送消息':'暂无收到的消息',meta:'随剧情推进更新',empty:true}];
  }else if(section==='contacts'){
   this.phoneHeading='联系人';this.phoneSub='随剧情推进更新';items=contacts.map(id=>({text:this.phoneContactName(id),meta:this._graph.phone.contactNumbers[id]||'Amadeus',fn:'openContact',value:id}));
   if(!items.length)items=[{text:'暂无开放的联系人',meta:'继续阅读后更新',empty:true}];
  }else if(section==='calls'){
   this.phoneHeading='电话与手机操作';this.phoneSub=call&&call.critical?'关键剧情操作':'当前剧情';
   if(call)items=[{text:call.kind==='power'?'关闭手机电源':'接听电话',meta:call.kind==='power'?'本段可以操作手机电源':callHeading(call),fn:'phoneAccept'},{text:'暂不处理，继续剧情',meta:'在原作允许的位置内仍可操作',fn:'phoneDecline'}];
   else items=[{text:'当前没有可用操作',meta:'电话会随剧情更新',empty:true}];
  }else if(section==='reply'){
   const record=this._replyRecord,texts=this._replyTexts||[];this.phoneHeading='回复 RINE';this.phoneSub=this._thread?this.contactName(this.threadPeer(this._thread)):'RINE';
   items=record.replies.map((r,i)=>({image:record.stampChoices?'/common/phone-stamps/'+r.id+'.png':'',text:record.stampChoices?'动画表情（'+(i+1)+'）':texts[r.id%256]||'回复 '+(i+1),meta:'选择后发送',fn:'sendRine',value:i,reply:true}));
  }
  this.phoneSub=cleanText(this.phoneSub);this.phoneSubFont=textFont(this.phoneSub);this._phoneItems=items;
  const pages=Math.max(1,Math.ceil(items.length/4));this._phonePage=Math.max(0,Math.min(pages-1,this._phonePage));
  const uid=++this._ui;this._phonePageItems=items.slice(this._phonePage*4,this._phonePage*4+4);
  this.phoneRows=this._phonePageItems.map((x,i)=>{const text=x.reply?wrapText(x.text,352,21):cleanText(x.text),titleHeight=x.reply?Math.max(28,text.split('\n').length*28):28;return {key:section+':'+uid+':'+i,text,image:x.image||'',font:textFont(text),meta:cleanText(x.meta||''),metaFont:textFont(x.meta||''),titleHeight,height:x.image?162:Math.max(73,titleHeight+36)};});
  this.phoneHeight=Math.max(322,this.phoneRows.reduce((n,x)=>n+x.height+4,0)+8);this.phonePageLabel=section==='reply'?'请选择回复内容':section==='home'?storyDate(this._state):pageLabel(this._phonePage,pages);
  this.phoneLeftLabel=pages>1?'‹ 上一页':'';this.phoneBackLabel=section==='home'?'返回剧情':section==='reply'?'取消回复':'返回手机';this.phoneRightLabel=pages>1?'下一页 ›':'';
  this.resetPhoneScroll();console.log('STEINS0_RW5 phone '+section+' '+this._phonePage+' '+items.length);
 },
 resetPhoneScroll(){try{this.$element('phone-scroll').scrollTo({top:0,left:0,behavior:'instant'});}catch(e){}},
 phonePick(index){if(this.loading)return;const item=this._phonePageItems&&this._phonePageItems[index];if(item&&!item.empty&&typeof this[item.fn]==='function')this[item.fn](item.value);},
 openPhoneCalls(){this._thread=null;this._phoneSection='calls';this._phonePage=0;this.renderPhone();},
 openContact(id){
  const active=phoneChoice(this._state);if(active&&active.kind==='call'&&callContact(active)===id){this.openPhoneCalls();return;}
  this._thread=null;this._replyBase=-1;this._phoneDetailBack='contacts';this.showPhoneDetail('联系人详情',this.phoneContactName(id),'联系人',[
   {text:'电话号码',kind:'label'},{text:this._graph.phone.contactNumbers[id]||'Amadeus',kind:'body'},{text:'',kind:'gap'},{text:'当前剧情没有开放此号码的通话。',kind:'label'}]);
 },
 phoneText(id,done,valid){
  if(valid&&!valid())return;const group=Math.floor(id/256),i=id%256;
  if(this._phoneCache&&this._phoneCache.group===group){done(this._phoneCache.texts[i]||'');return;}
  this.readJSON('/common/phone/'+group+'.txt',texts=>{this._phoneCache={group,texts};done(texts[i]||'');},valid);
 },
 openMessage(message){this.openThread(threadForMessage(this._state,message,this._phoneSection==='sent'));},
 openThread(thread){
  if(this._phoneSection==='inbox'||this._phoneSection==='sent'){this._mailboxSection=this._phoneSection;this._mailboxPage=this._phonePage;}
  this._thread=thread;this._threadPage=0;this.renderThread();
 },
 renderThread(){
  const thread=this._thread;if(!thread)return;this.phoneReplyLabel='';const messages=conversationMessages(this._state,thread);this._threadPage=0;
  this._replyBase=thread.base;this._phoneDetailBack=this._mailboxSection||'inbox';this._phoneSection='detail';this.setMode('phone');const token=++this._phoneSeq,valid=()=>this.mode==='phone'&&this._phoneSeq===token;this.loading=true;
  const current=messages,parts=[];let i=0;
  const nextPart=()=>{
   if(!valid())return;
   if(i>=current.length){
    if(!canReply(this._state,thread)){const replied=this._state.replied.indexOf(thread.base)>=0,wasReply=(this._graph.phone.replyBases||[]).indexOf(thread.base)>=0;parts.push({kind:'label',text:replied?'已回复':wasReply?'此条消息已过原作回复时机':'此段对话没有回复选项'});}
    this.showPhoneDetail(thread.sent?'已发送':'RINE',this.contactName(this.threadPeer(thread)),mailDateLabel(thread.date)+' · '+messages.length+' 条消息 · 上下滑动查看',parts);
    markMessagesRead(this._state,current);console.log('STEINS0_RW5 thread-read '+thread.base+' '+this._threadPage+' '+this._state.read.length);
    this.phoneReplyLabel=canReply(this._state,thread)?'回复':'';this.phoneLeftLabel='';this.phoneRightLabel=canReply(this._state,thread)?'回复':'继续剧情';this.phoneBackLabel='返回列表';console.log('STEINS0_RW5 thread '+thread.base+' '+this._threadPage+' '+messages.length);return;
   }
   const m=current[i++];parts.push({text:this.contactName(m.sender),kind:'sender'});
   if(m.stamp){parts.push({kind:'stamp',image:'/common/phone-stamps/'+m.id+'.png'},{kind:'gap'});nextPart();}
   else this.phoneText(m.id,text=>{parts.push({text,kind:'body'},{kind:'gap'});nextPart();},valid);
  };nextPart();
 },
 showPhoneDetail(title,sub,caption,parts){
  this._phoneSeq++;this._phoneSection='detail';this.setMode('phone');this.loading=false;this.phoneRows=[];this.phoneReplyLabel='';this.phoneHeading=title;this.phoneSub=cleanText(sub||'');this.phoneSubFont=textFont(this.phoneSub);this.phonePageLabel=caption;
  const uid=++this._ui,lines=[];let height=0;
  for(const part of parts){
   if(part.kind==='stamp'){lines.push({id:uid+':'+lines.length,text:'',image:part.image,font:'sans-serif',size:15,color:'#aaa',height:150});height+=150;continue;}
   if(part.kind==='gap'){lines.push({id:uid+':'+lines.length,text:'',image:'',font:'sans-serif',size:15,color:'#a89d97',height:14});height+=14;continue;}
   const label=part.kind==='label',sender=part.kind==='sender',size=label?16:sender?19:23,h=label?26:sender?28:30;
   const wrapped=wrapText(cleanText(part.text),380,size),color=label?'#9e9390':sender?'#b5d0d2':'#e4ddd6';
   for(const line of wrapped.split('\n')){lines.push({id:uid+':'+lines.length,text:line,image:'',font:textFont(line),size,color,height:h});height+=h;}
  }
  this.phoneLines=lines;this.phoneHeight=Math.max(322,height+20);this.phoneLeftLabel='';this.phoneBackLabel=this._phoneDetailBack==='contacts'?'返回联系人':'返回列表';this.phoneRightLabel='继续剧情';this.resetPhoneScroll();console.log('STEINS0_RW5 phone detail '+caption);
 },
 replyMessage(){
  const window=this._state.replyWindows.find(x=>x.base===this._replyBase);if(!window)return;
  const token=++this._phoneSeq;this.loading=true;const valid=()=>this.mode==='phone'&&token===this._phoneSeq;
  this.readJSON('/common/reply/'+window.key+'.txt',record=>{this._replyRecord=record;
   const show=texts=>{this._replyTexts=texts;this.loading=false;this._phoneSection='reply';this._phonePage=0;this.renderPhone();};
   if(record.stampChoices)show([]);else this.phoneText(record.base,()=>show(this._phoneCache.texts),valid);
  },valid);
 },
 sendRine(index){
  try{sendReply(this._state,this._replyRecord,index);this._thread.sent=true;this._mailboxSection='sent';this._mailboxPage=0;this._threadPage=0;this.renderThread();}catch(e){this.fail(e);}
 },
 phoneLeft(){if(this._phoneSection==='detail'){return;}if(this._phonePage>0){this._phonePage--;this.renderPhone();}},
 phoneRight(){if(this._phoneSection==='detail'){if(this._thread&&canReply(this._state,this._thread))this.replyMessage();else this.resume();return;}if(this._phonePage<Math.ceil(this._phoneItems.length/4)-1){this._phonePage++;this.renderPhone();}},
 phoneBack(){
  if(this._phoneSection==='home'){this.resume();return;}
  if(this._phoneSection==='reply'){this.renderThread();return;}
  const detail=this._phoneSection==='detail';this._phoneSection=detail?(this._phoneDetailBack||'inbox'):'home';this._phonePage=detail?(this._mailboxPage||0):0;this._thread=null;this.renderPhone();
 }

};
</script>
