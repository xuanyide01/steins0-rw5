 refreshNotice(){
  if(this._noticeTimer)clearInterval(this._noticeTimer);this._noticeTimer=null;
  const state=this._state;if(!state||this.mode!=='play'||!this._visible)return;
  const incoming=state.inbox.some(x=>state.read.indexOf(x.key)<0),call=phoneChoice(state);
  this.phoneLabel=call?'来电／手机':incoming?'有新 RINE':'手机';this.noticeColor='#c7bcaf';
  if(call||incoming){let on=true;this._noticeTimer=setInterval(()=>{on=!on;this.noticeColor=on?'#b5d1d4':'#6f6261';},700);}
 },
 showPhone(){if(!this._state)return;this._phoneSection='home';this._phonePage=0;this.renderPhone();},
 phoneAccept(){try{answerCall(this._state,true);this.present();}catch(e){this.fail(e);}},
 phoneDecline(){try{answerCall(this._state,false);this.present();}catch(e){this.fail(e);}},
 openInbox(){markRead(this._state);this._phoneSection='inbox';this._phonePage=0;this.renderPhone();},
 openSent(){this._phoneSection='sent';this._phonePage=0;this.renderPhone();},
 openContacts(){this._phoneSection='contacts';this._phonePage=0;this.renderPhone();},
 contactName(id){return this._graph.phone.names[id]||this._graph.phone.contactNames[id]||'Unknown';},
 phoneContactName(id){return this._graph.phone.contactNames[id]||this._graph.phone.contactNumbers[id]||'Unknown';},
 renderPhone(){
  if(!this._state)return;this._phoneSeq++;this.setMode('phone');this.loading=false;this.phoneLines=[];this._phonePage=this._phonePage||0;
  const section=this._phoneSection||'home',call=phoneChoice(this._state),contacts=this._graph.phone.contacts.filter((id,i)=>this._state.contacts&(1<<i));let items=[];
  this.phoneSub='RINE';this.phoneSubFont='sans-serif';
  if(section==='home'){
   this.phoneHeading='手机';items=[{text:'收信箱',meta:this._state.inbox.length+' 条消息',fn:'openInbox'},{text:'已发送',meta:this._state.sent.length+' 条消息',fn:'openSent'},{text:'联系人',meta:contacts.length+' 位联系人',fn:'openContacts'}];
   if(call)items.push({text:'当前电话与手机操作',meta:call.critical?'本段有关键操作':'本段有可处理来电',fn:'openPhoneCalls'});
  }else if(section==='inbox'||section==='sent'){
   const sent=section==='sent',messages=(sent?this._state.sent:this._state.inbox).slice().reverse();this.phoneHeading=sent?'已发送':'收信箱';this.phoneSub=messages.length+' 条 RINE';
   items=messages.map(x=>({text:this.contactName(x.outgoing?0:x.sender),meta:x.stamp?'动画表情':'点击查看消息',fn:'openMessage',value:x,message:x}));
   if(!items.length)items=[{text:sent?'暂无已发送消息':'暂无收到的消息',meta:'随剧情推进更新',empty:true}];
  }else if(section==='contacts'){
   this.phoneHeading='联系人';this.phoneSub='随剧情推进更新';items=contacts.map(id=>({text:this.phoneContactName(id),meta:this._graph.phone.contactNumbers[id]||'Amadeus',fn:'openContact',value:id}));
   if(!items.length)items=[{text:'暂无开放的联系人',meta:'继续阅读后更新',empty:true}];
  }else if(section==='calls'){
   this.phoneHeading='电话与手机操作';this.phoneSub=call&&call.critical?'关键剧情操作':'当前剧情';
   if(call)items=[{text:call.kind==='power'?'关闭手机电源':'接听电话',meta:call.kind==='power'?'本段可以操作手机电源':call.heading,fn:'phoneAccept'},{text:'暂不处理，继续剧情',meta:'在原作允许的位置内仍可操作',fn:'phoneDecline'}];
   else items=[{text:'当前没有可用操作',meta:'电话会随剧情更新',empty:true}];
  }else if(section==='reply'){
   const record=this._replyRecord,texts=this._replyTexts||[];this.phoneHeading='回复 RINE';this.phoneSub=this._message?this.contactName(this._message.sender):'RINE';
   items=record.replies.map((r,i)=>({text:record.stampChoices?'动画表情（'+(i+1)+'）':texts[r.id%256]||'回复 '+(i+1),meta:'选择后发送',fn:'sendRine',value:i,reply:true}));
  }
  this.phoneSub=cleanText(this.phoneSub);this.phoneSubFont=textFont(this.phoneSub);this._phoneItems=items;
  const pages=Math.max(1,Math.ceil(items.length/4));this._phonePage=Math.max(0,Math.min(pages-1,this._phonePage));
  const uid=++this._ui;this._phonePageItems=items.slice(this._phonePage*4,this._phonePage*4+4);
  this.phoneRows=this._phonePageItems.map((x,i)=>{const text=x.reply?wrapText(x.text,352,21):cleanText(x.text),titleHeight=x.reply?Math.max(28,text.split('\n').length*28):28;return {key:section+':'+uid+':'+i,text,font:textFont(text),meta:cleanText(x.meta||''),metaFont:textFont(x.meta||''),titleHeight,height:Math.max(73,titleHeight+36)};});
  this.phoneHeight=Math.max(322,this.phoneRows.reduce((n,x)=>n+x.height+4,0)+8);this.phonePageLabel=section==='reply'?'请选择回复内容':section==='home'?storyDate(this._state):pageLabel(this._phonePage,pages);
  this.phoneLeftLabel=pages>1?'‹ 上一页':'';this.phoneBackLabel=section==='home'?'返回剧情':section==='reply'?'取消回复':'返回手机';this.phoneRightLabel=pages>1?'下一页 ›':'';
  this.resetPhoneScroll();this.refreshPhonePreviews();console.log('STEINS0_RW5 phone '+section+' '+this._phonePage+' '+items.length);
 },
 resetPhoneScroll(){try{this.$element('phone-scroll').scrollTo({top:0,left:0,behavior:'instant'});}catch(e){}},
 refreshPhonePreviews(){
  const token=this._phoneSeq,rows=this._phonePageItems||[],valid=()=>this.mode==='phone'&&token===this._phoneSeq;let i=0;
  const step=()=>{if(!valid()||i>=rows.length)return;const index=i++,row=rows[index],m=row.message;if(!m||m.stamp){step();return;}
   this.phoneText(m.id,text=>{if(!valid())return;const preview=cleanText(text).replace(/\n/g,' ').slice(0,22);this.phoneRows=this.phoneRows.map((x,j)=>j===index?Object.assign({},x,{meta:preview||'点击查看消息',metaFont:textFont(preview)}):x);step();},valid);
  };step();
 },
 phonePick(index){if(this.loading)return;const item=this._phonePageItems&&this._phonePageItems[index];if(item&&!item.empty&&typeof this[item.fn]==='function')this[item.fn](item.value);},
 openPhoneCalls(){this._phoneSection='calls';this._phonePage=0;this.renderPhone();},
 openContact(id){
  const active=phoneChoice(this._state);if(active&&active.kind==='call'&&active.contact===id){this.openPhoneCalls();return;}
  this._replyBase=-1;this._phoneDetailBack='contacts';this.showPhoneDetail('联系人详情',this.phoneContactName(id),'联系人',[
   {text:'电话号码',kind:'label'},{text:this._graph.phone.contactNumbers[id]||'Amadeus',kind:'body'},{text:'',kind:'gap'},{text:'当前剧情没有开放此号码的通话。',kind:'label'}]);
 },
 phoneText(id,done,valid){
  if(valid&&!valid())return;const group=Math.floor(id/256),i=id%256;
  if(this._phoneCache&&this._phoneCache.group===group){done(this._phoneCache.texts[i]||'');return;}
  this.readJSON('/common/phone/'+group+'.txt',texts=>{this._phoneCache={group,texts};done(texts[i]||'');},valid);
 },
 openMessage(message){
  this._message=message;this._replyBase=message.stamp?-1:Math.floor(message.id/256)*256;this._phoneDetailBack=this._phoneSection==='sent'?'sent':'inbox';
  const name=this.contactName(message.outgoing?0:message.sender),parts=[{text:message.outgoing?'发送人':'发件人',kind:'label'},{text:name,kind:'sender'},{text:'',kind:'gap'}];
  if(message.stamp){parts.push({text:'动画表情',kind:'stamp'});this.showPhoneDetail(message.outgoing?'已发送':'RINE',name,message.outgoing?'发送内容':'收到的消息',parts);return;}
  const token=++this._phoneSeq;this.loading=true;const valid=()=>this.mode==='phone'&&this._phoneSeq===token;
  this.phoneText(message.id,text=>{this.loading=false;parts.push({text,kind:'body'});this.showPhoneDetail(message.outgoing?'已发送':'RINE',name,message.outgoing?'发送内容':'收到的消息',parts);},valid);
 },
 showPhoneDetail(title,sub,caption,parts){
  this._phoneSeq++;this._phoneSection='detail';this.setMode('phone');this.loading=false;this.phoneRows=[];this.phoneHeading=title;this.phoneSub=cleanText(sub||'');this.phoneSubFont=textFont(this.phoneSub);this.phonePageLabel=caption;
  const uid=++this._ui,lines=[];let height=0;
  for(const part of parts){
   if(part.kind==='gap'){lines.push({id:uid+':'+lines.length,text:'',font:'sans-serif',size:15,color:'#a89d97',height:14});height+=14;continue;}
   const stamp=part.kind==='stamp',label=part.kind==='label',sender=part.kind==='sender',size=stamp?20:label?16:sender?19:23,h=stamp?42:label?26:sender?28:30;
   const text=stamp?'动画表情':cleanText(part.text),wrapped=wrapText(text,380,size),color=stamp?'#a99b94':label?'#9e9390':sender?'#b5d0d2':'#e4ddd6';
   for(const line of wrapped.split('\n')){lines.push({id:uid+':'+lines.length,text:line,font:textFont(line),size,color,height:h});height+=h;}
  }
  this.phoneLines=lines;this.phoneHeight=Math.max(322,height+20);this.phoneLeftLabel=this._state.replyWindows.some(x=>x.base===this._replyBase)?'回复':'';this.phoneBackLabel=this._phoneDetailBack==='contacts'?'返回联系人':'返回列表';this.phoneRightLabel='继续剧情';this.resetPhoneScroll();console.log('STEINS0_RW5 phone detail '+caption);
 },
 replyMessage(){
  const window=this._state.replyWindows.find(x=>x.base===this._replyBase);if(!window)return;
  const token=++this._phoneSeq;this.loading=true;const valid=()=>this.mode==='phone'&&token===this._phoneSeq;
  this.readJSON('/common/reply/'+window.key+'.txt',record=>{this._replyRecord=record;
   const show=texts=>{this._replyTexts=texts;this.loading=false;this._phoneSection='reply';this._phonePage=0;this.renderPhone();};
   if(record.stampChoices)show([]);else this.phoneText(record.base,()=>show(this._phoneCache.texts),valid);
  },valid);
 },
 sendRine(index){
  try{const sequence=sendReply(this._state,this._replyRecord,index),base=this._replyRecord.base,token=++this._phoneSeq;this.loading=true;
   this.phoneText(base,()=>{const texts=this._phoneCache.texts,parts=[];for(const row of sequence){parts.push({text:this.contactName(row.sender),kind:'sender'},{text:row.stamp?'动画表情':texts[row.id%256]||'',kind:row.stamp?'stamp':'body'},{text:'',kind:'gap'});}this._phoneDetailBack='sent';this.showPhoneDetail('已发送',this.contactName(0),'发送内容及后续对话',parts);},()=>this.mode==='phone'&&token===this._phoneSeq);
  }catch(e){this.fail(e);}
 },
 phoneLeft(){if(this._phoneSection==='detail'){this.replyMessage();return;}if(this._phonePage>0){this._phonePage--;this.renderPhone();}},
 phoneRight(){if(this._phoneSection==='detail'){this.resume();return;}if(this._phonePage<Math.ceil(this._phoneItems.length/4)-1){this._phonePage++;this.renderPhone();}},
 phoneBack(){
  if(this._phoneSection==='home'){this.resume();return;}
  if(this._phoneSection==='reply'){this.openMessage(this._message);return;}
  this._phoneSection=this._phoneSection==='detail'?(this._phoneDetailBack||'inbox'):'home';this._phonePage=0;this.renderPhone();
 }
