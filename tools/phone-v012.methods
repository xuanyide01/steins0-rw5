 refreshNotice(){
  if(this._noticeTimer)clearInterval(this._noticeTimer);this._noticeTimer=null;
  const state=this._state;if(!state||this.mode!=='play'||!this._visible)return;
  const incoming=state.inbox.some(x=>state.read.indexOf(x.key)<0),call=phoneChoice(state);
  this.phoneLabel=call?'来电／手机':incoming?'有新 RINE':'手机';this.noticeColor='#c7bcaf';
  if(call||incoming){let on=true;this._noticeTimer=setInterval(()=>{on=!on;this.noticeColor=on?'#b5d1d4':'#6f6261';},700);}
 },
 showPhone(){if(!this._state)return;this._thread=null;this._phoneSection='home';this._phonePage=0;this.renderPhone();},
 phoneAccept(){try{answerCall(this._state,true);this.present();}catch(e){this.fail(e);}},
 phoneDecline(){try{answerCall(this._state,false);this.present();}catch(e){this.fail(e);}},
 openInbox(){markRead(this._state);this._thread=null;this._phoneSection='inbox';this._phonePage=0;this.renderPhone();},
 openSent(){this._thread=null;this._phoneSection='sent';this._phonePage=0;this.renderPhone();},
 openContacts(){this._thread=null;this._phoneSection='contacts';this._phonePage=0;this.renderPhone();},
 contactName(id){return this._graph.phone.names[id]||this._graph.phone.contactNames[id]||'Unknown';},
 phoneContactName(id){return this._graph.phone.contactNames[id]||this._graph.phone.contactNumbers[id]||'Unknown';},
 threadPeer(thread){if(!thread.sent)return thread.sender;const m=conversationMessages(this._state,thread).find(x=>x.sender!==0);return m?m.sender:thread.latest.contact;},
 renderPhone(){
  if(!this._state)return;this._phoneSeq++;this.setMode('phone');this.loading=false;this.phoneLines=[];this.phoneReplyLabel='';this._phonePage=this._phonePage||0;
  const section=this._phoneSection||'home',call=phoneChoice(this._state),contacts=this._graph.phone.contacts.filter((id,i)=>this._state.contacts&(1<<i));let items=[];
  this.phoneSub='RINE';this.phoneSubFont='sans-serif';
  if(section==='home'){
   this.phoneHeading='手机';items=[{text:'收信箱',meta:mailboxThreads(this._state,false).length+' 组 · '+this._state.inbox.length+' 条消息',fn:'openInbox'},{text:'已发送',meta:mailboxThreads(this._state,true).length+' 组 · '+this._state.sent.length+' 条消息',fn:'openSent'},{text:'联系人',meta:contacts.length+' 位联系人',fn:'openContacts'}];
   if(call)items.push({text:'当前电话与手机操作',meta:call.critical?'本段有关键操作':'本段有可处理来电',fn:'openPhoneCalls'});
  }else if(section==='inbox'||section==='sent'){
   const sent=section==='sent',threads=mailboxThreads(this._state,sent);this.phoneHeading=sent?'已发送':'收信箱';this.phoneSub=threads.length+' 组对话 · '+(sent?this._state.sent:this._state.inbox).length+' 条消息';
   items=threads.map(t=>({text:this.contactName(this.threadPeer(t)),meta:mailDateLabel(t.date)+' · '+t.messages.length+' 条消息'+(t.latest.stamp?' · 动画表情':' · 点击查看'),fn:'openThread',value:t}));
   if(!items.length)items=[{text:sent?'暂无已发送消息':'暂无收到的消息',meta:'随剧情推进更新',empty:true}];
  }else if(section==='contacts'){
   this.phoneHeading='联系人';this.phoneSub='随剧情推进更新';items=contacts.map(id=>({text:this.phoneContactName(id),meta:this._graph.phone.contactNumbers[id]||'Amadeus',fn:'openContact',value:id}));
   if(!items.length)items=[{text:'暂无开放的联系人',meta:'继续阅读后更新',empty:true}];
  }else if(section==='calls'){
   this.phoneHeading='电话与手机操作';this.phoneSub=call&&call.critical?'关键剧情操作':'当前剧情';
   if(call)items=[{text:call.kind==='power'?'关闭手机电源':'接听电话',meta:call.kind==='power'?'本段可以操作手机电源':call.heading,fn:'phoneAccept'},{text:'暂不处理，继续剧情',meta:'在原作允许的位置内仍可操作',fn:'phoneDecline'}];
   else items=[{text:'当前没有可用操作',meta:'电话会随剧情更新',empty:true}];
  }else if(section==='reply'){
   const record=this._replyRecord,texts=this._replyTexts||[];this.phoneHeading='回复 RINE';this.phoneSub=this._thread?this.contactName(this.threadPeer(this._thread)):'RINE';
   items=record.replies.map((r,i)=>({text:record.stampChoices?'动画表情（'+(i+1)+'）':texts[r.id%256]||'回复 '+(i+1),meta:'选择后发送',fn:'sendRine',value:i,reply:true}));
  }
  this.phoneSub=cleanText(this.phoneSub);this.phoneSubFont=textFont(this.phoneSub);this._phoneItems=items;
  const pages=Math.max(1,Math.ceil(items.length/4));this._phonePage=Math.max(0,Math.min(pages-1,this._phonePage));
  const uid=++this._ui;this._phonePageItems=items.slice(this._phonePage*4,this._phonePage*4+4);
  this.phoneRows=this._phonePageItems.map((x,i)=>{const text=x.reply?wrapText(x.text,352,21):cleanText(x.text),titleHeight=x.reply?Math.max(28,text.split('\n').length*28):28;return {key:section+':'+uid+':'+i,text,font:textFont(text),meta:cleanText(x.meta||''),metaFont:textFont(x.meta||''),titleHeight,height:Math.max(73,titleHeight+36)};});
  this.phoneHeight=Math.max(322,this.phoneRows.reduce((n,x)=>n+x.height+4,0)+8);this.phonePageLabel=section==='reply'?'请选择回复内容':section==='home'?storyDate(this._state):pageLabel(this._phonePage,pages);
  this.phoneLeftLabel=pages>1?'‹ 上一页':'';this.phoneBackLabel=section==='home'?'返回剧情':section==='reply'?'取消回复':'返回手机';this.phoneRightLabel=pages>1?'下一页 ›':'';
  this.resetPhoneScroll();console.log('STEINS0_RW5 phone '+section+' '+this._phonePage+' '+items.length);
 },
 resetPhoneScroll(){try{this.$element('phone-scroll').scrollTo({top:0,left:0,behavior:'instant'});}catch(e){}},
 phonePick(index){if(this.loading)return;const item=this._phonePageItems&&this._phonePageItems[index];if(item&&!item.empty&&typeof this[item.fn]==='function')this[item.fn](item.value);},
 openPhoneCalls(){this._thread=null;this._phoneSection='calls';this._phonePage=0;this.renderPhone();},
 openContact(id){
  const active=phoneChoice(this._state);if(active&&active.kind==='call'&&active.contact===id){this.openPhoneCalls();return;}
  this._thread=null;this._replyBase=-1;this._phoneDetailBack='contacts';this.showPhoneDetail('联系人详情',this.phoneContactName(id),'联系人',[
   {text:'电话号码',kind:'label'},{text:this._graph.phone.contactNumbers[id]||'Amadeus',kind:'body'},{text:'',kind:'gap'},{text:'当前剧情没有开放此号码的通话。',kind:'label'}]);
 },
 phoneText(id,done,valid){
  if(valid&&!valid())return;const group=Math.floor(id/256),i=id%256;
  if(this._phoneCache&&this._phoneCache.group===group){done(this._phoneCache.texts[i]||'');return;}
  this.readJSON('/common/phone/'+group+'.txt',texts=>{this._phoneCache={group,texts};done(texts[i]||'');},valid);
 },
 openMessage(message){this.openThread(threadForMessage(this._state,message,this._phoneSection==='sent'));},
 openThread(thread){
  if(this._phoneSection==='inbox'||this._phoneSection==='sent'){this._mailboxSection=this._phoneSection;this._mailboxPage=this._phonePage;}
  this._thread=thread;this._threadPage=0;this.renderThread();
 },
 renderThread(){
  const thread=this._thread;if(!thread)return;this.phoneReplyLabel='';const messages=conversationMessages(this._state,thread),pages=Math.max(1,Math.ceil(messages.length/8));this._threadPage=Math.max(0,Math.min(pages-1,this._threadPage||0));
  this._replyBase=thread.base;this._phoneDetailBack=this._mailboxSection||'inbox';this._phoneSection='detail';this.setMode('phone');const token=++this._phoneSeq,valid=()=>this.mode==='phone'&&this._phoneSeq===token;this.loading=true;
  const current=messages.slice(this._threadPage*8,this._threadPage*8+8),parts=[];let i=0;
  const nextPart=()=>{
   if(!valid())return;
   if(i>=current.length){
    this.showPhoneDetail(thread.sent?'已发送':'RINE',this.contactName(this.threadPeer(thread)),mailDateLabel(thread.date)+' · '+messages.length+' 条消息 · '+pageLabel(this._threadPage,pages),parts);
    this.phoneReplyLabel=this._state.replyWindows.some(x=>x.base===thread.base)?'回复':'';this.phoneLeftLabel=this._threadPage>0?'‹ 较早消息':'';this.phoneRightLabel=this._threadPage<pages-1?'较新消息 ›':'继续剧情';this.phoneBackLabel='返回列表';console.log('STEINS0_RW5 thread '+thread.base+' '+this._threadPage+' '+messages.length);return;
   }
   const m=current[i++];parts.push({text:this.contactName(m.sender),kind:'sender'});
   if(m.stamp){parts.push({kind:'stamp',image:'/common/phone-stamps/'+m.id+'.png'},{kind:'gap'});nextPart();}
   else this.phoneText(m.id,text=>{parts.push({text,kind:'body'},{kind:'gap'});nextPart();},valid);
  };nextPart();
 },
 showPhoneDetail(title,sub,caption,parts){
  this._phoneSeq++;this._phoneSection='detail';this.setMode('phone');this.loading=false;this.phoneRows=[];this.phoneReplyLabel='';this.phoneHeading=title;this.phoneSub=cleanText(sub||'');this.phoneSubFont=textFont(this.phoneSub);this.phonePageLabel=caption;
  const uid=++this._ui,lines=[];let height=0;
  for(const part of parts){
   if(part.kind==='stamp'){lines.push({id:uid+':'+lines.length,text:'',image:part.image,font:'sans-serif',size:15,color:'#aaa',height:150});height+=150;continue;}
   if(part.kind==='gap'){lines.push({id:uid+':'+lines.length,text:'',image:'',font:'sans-serif',size:15,color:'#a89d97',height:14});height+=14;continue;}
   const label=part.kind==='label',sender=part.kind==='sender',size=label?16:sender?19:23,h=label?26:sender?28:30;
   const wrapped=wrapText(cleanText(part.text),380,size),color=label?'#9e9390':sender?'#b5d0d2':'#e4ddd6';
   for(const line of wrapped.split('\n')){lines.push({id:uid+':'+lines.length,text:line,image:'',font:textFont(line),size,color,height:h});height+=h;}
  }
  this.phoneLines=lines;this.phoneHeight=Math.max(322,height+20);this.phoneLeftLabel='';this.phoneBackLabel=this._phoneDetailBack==='contacts'?'返回联系人':'返回列表';this.phoneRightLabel='继续剧情';this.resetPhoneScroll();console.log('STEINS0_RW5 phone detail '+caption);
 },
 replyMessage(){
  const window=this._state.replyWindows.find(x=>x.base===this._replyBase);if(!window)return;
  const token=++this._phoneSeq;this.loading=true;const valid=()=>this.mode==='phone'&&token===this._phoneSeq;
  this.readJSON('/common/reply/'+window.key+'.txt',record=>{this._replyRecord=record;
   const show=texts=>{this._replyTexts=texts;this.loading=false;this._phoneSection='reply';this._phonePage=0;this.renderPhone();};
   if(record.stampChoices)show([]);else this.phoneText(record.base,()=>show(this._phoneCache.texts),valid);
  },valid);
 },
 sendRine(index){
  try{const before=conversationMessages(this._state,this._thread).length;sendReply(this._state,this._replyRecord,index);this._thread.sent=true;this._mailboxSection='sent';this._mailboxPage=0;this._threadPage=Math.floor(before/8);this.renderThread();}catch(e){this.fail(e);}
 },
 phoneLeft(){if(this._phoneSection==='detail'){if(this._thread&&this._threadPage>0){this._threadPage--;this.renderThread();}return;}if(this._phonePage>0){this._phonePage--;this.renderPhone();}},
 phoneRight(){if(this._phoneSection==='detail'){if(this._thread&&this._threadPage<Math.ceil(conversationMessages(this._state,this._thread).length/8)-1){this._threadPage++;this.renderThread();}else this.resume();return;}if(this._phonePage<Math.ceil(this._phoneItems.length/4)-1){this._phonePage++;this.renderPhone();}},
 phoneBack(){
  if(this._phoneSection==='home'){this.resume();return;}
  if(this._phoneSection==='reply'){this.renderThread();return;}
  const detail=this._phoneSection==='detail';this._phoneSection=detail?(this._phoneDetailBack||'inbox'):'home';this._phonePage=detail?(this._mailboxPage||0):0;this._thread=null;this.renderPhone();
 }
