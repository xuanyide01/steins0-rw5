<template>
 <div class="page" onswipe="swipe">
  <div if="{{mode === 'title'}}" class="title-page">
   <image class="title-background" src="/common/title_bg.jpg"></image>
   <div if="{{animationEnabled && !mediaBusy}}" class="zero-viewport"><image class="zero-sheet" src="{{zeroSrc}}" style="left:{{zeroLeft}}px;"></image></div>
   <image class="brand-logo" src="/common/title-wordmark.png"></image>
   <div class="title-buttons">
    <image class="title-button" src="/common/ui/start.png" onclick="startNew"></image>
    <image class="title-button" src="/common/ui/load.png" onclick="loadGame"></image>
    <image class="title-button" src="/common/ui/extra.png" onclick="openExtra"></image>
    <image class="title-button" src="/common/ui/config.png" onclick="openConfig"></image>
   </div>
   <div class="title-rule"></div><text class="motto">El Psy Kongroo</text>
  </div>
  <div if="{{mode === 'play'}}" class="reading">
   <div class="scene" onclick="advance"><image for="{{sceneImages}}" tid="key" class="layer" src="{{$item.src}}" style="left:{{$item.left}}px;top:{{$item.top}}px;width:{{$item.width}}px;height:{{$item.height}}px;opacity:{{$item.opacity}};"></image></div>
   <div class="speaker-row"><text class="speaker" style="font-family:{{speakerFont}};">{{speaker}}</text><text class="date">{{dateLabel}}</text></div>
   <scroll id="dialogue-scroll" class="dialogue-scroll" scroll-y="true" onclick="dialogueTap" ontouchstart="touchStart" ontouchmove="touchMove" ontouchend="touchEnd" onscroll="scrolled"><div class="dialogue-content" style="height:{{dialogueHeight}}px;"><text for="{{lines}}" tid="id" class="line" style="font-family:{{bodyFont}};font-size:{{fontSize}}px;">{{$item.text}}</text></div></scroll>
   <div class="toolbar"><text class="tool" onclick="goBack">上一句</text><text class="tool" onclick="showMenu">{{autoEnabled ? 'AUTO' : '菜单'}}</text><text class="phone-tool" style="color:{{noticeColor}};" onclick="showPhone">{{phoneLabel}}</text><text class="tool" onclick="advance">下一句 ›</text></div>
  </div>
  <div if="{{mode === 'card'}}" class="card-page" onclick="closeCard"><image class="chapter-card" src="{{cardSrc}}"></image></div>
  <div if="{{mode === 'menu' || mode === 'extra' || mode === 'config' || mode === 'choice' || mode === 'end' || mode === 'overwrite'}}" class="panel">
   <text class="section-code">{{panelCode}}</text><text class="heading" style="font-family:{{headingFont}};">{{heading}}</text>
   <text if="{{subtitle !== ''}}" class="subtitle" style="font-family:{{subtitleFont}};">{{subtitle}}</text>
   <scroll id="actions-scroll" class="actions" style="top:{{actionsTop}}px;height:{{actionsViewport}}px;" scroll-y="true"><div class="actions-content" style="height:{{actionsHeight}}px;"><text for="{{actions}}" tid="key" class="action" style="height:{{$item.height}}px;color:{{$item.color}};font-family:{{$item.font}};" onclick="action($idx)">{{$item.text}}</text></div></scroll>
  </div>
  <div if="{{mode === 'list'}}" class="panel">
   <text class="section-code">{{listCode}}</text><text class="heading" style="font-family:{{headingFont}};">{{heading}}</text>
   <text if="{{subtitle !== ''}}" class="list-subtitle" style="font-family:{{subtitleFont}};">{{subtitle}}</text><text class="page-label">{{pageLabel}}</text>
   <div class="rows"><div for="{{rows}}" tid="key" class="row" onclick="rowPick($idx)"><text class="row-title" style="font-family:{{$item.font}};">{{$item.text}}</text><text class="row-meta" style="font-family:{{$item.metaFont}};">{{$item.meta}}</text><text if="{{$item.preview !== ''}}" class="row-preview" style="font-family:{{$item.previewFont}};">{{$item.preview}}</text></div></div>
   <div class="pager"><text class="pager-action" onclick="previousPage">‹ 上一页</text><text class="pager-action" onclick="listBack">返回</text><text class="pager-action" onclick="nextPage">下一页 ›</text></div>
  </div>
  <div if="{{mode === 'gallery'}}" class="panel">
   <text class="section-code">CG LIBRARY</text><text class="heading">CG 鉴赏</text><text class="gallery-page-label">{{galleryPageLabel}}</text>
   <div class="gallery-row gallery-first"><div for="{{galleryTop}}" tid="key" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text class="gallery-caption">{{$item.label}}</text><text class="gallery-count">{{$item.count}}</text></div></div>
   <div class="gallery-row gallery-second"><div for="{{galleryBottom}}" tid="key" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text class="gallery-caption">{{$item.label}}</text><text class="gallery-count">{{$item.count}}</text></div></div>
   <div class="pager"><text class="pager-action" onclick="previousGalleryPage">‹ 上一页</text><text class="pager-action" onclick="openExtra">返回</text><text class="pager-action" onclick="nextGalleryPage">下一页 ›</text></div>
  </div>
  <div if="{{mode === 'cg'}}" class="cg-page">
   <image class="cg-image" src="{{cgSrc}}" onclick="cycleCg"></image><text class="cg-label">{{cgLabel}}</text>
   <div class="cg-controls"><text class="pager-action" onclick="previousCg">‹ 上一组</text><text class="pager-action" onclick="galleryBack">返回列表</text><text class="pager-action" onclick="nextCg">下一组 ›</text></div>
  </div>
  <div if="{{mode === 'phone'}}" class="panel phone-panel">
   <text class="section-code">PHONE</text><text class="heading">{{phoneHeading}}</text><text class="phone-subtitle" style="font-family:{{phoneSubFont}};">{{phoneSub}}</text><text class="phone-page-label">{{phonePageLabel}}</text>
   <scroll id="phone-scroll" class="phone-scroll" scroll-y="true"><div class="phone-content" style="height:{{phoneHeight}}px;">
    <div for="{{phoneRows}}" tid="key" class="phone-row" style="height:{{$item.height}}px;" onclick="phonePick($idx)"><text class="phone-row-title" style="height:{{$item.titleHeight}}px;font-family:{{$item.font}};">{{$item.text}}</text><text class="phone-row-meta" style="font-family:{{$item.metaFont}};">{{$item.meta}}</text></div>
    <text for="{{phoneLines}}" tid="id" class="phone-line" style="height:{{$item.height}}px;line-height:{{$item.height}}px;font-size:{{$item.size}}px;font-family:{{$item.font}};color:{{$item.color}};">{{$item.text}}</text>
   </div></scroll>
   <div class="pager"><text class="pager-action" onclick="phoneLeft">{{phoneLeftLabel}}</text><text class="pager-action" onclick="phoneBack">{{phoneBackLabel}}</text><text class="pager-action" onclick="phoneRight">{{phoneRightLabel}}</text></div>
  </div>
  <div if="{{mode === 'error'}}" class="panel"><text class="section-code">SYSTEM</text><text class="heading">暂时无法继续</text><text class="error">{{errorText}}</text><text class="error-return" onclick="toTitle">返回标题</text></div>
  <text if="{{loading}}" class="loading">加载中…</text>
 </div>
</template>
